<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        INTERNET permission: used solely for one-time download of the Gemma 3 1B
        quantized model (~529 MB) from HuggingFace. The app never sends any data
        to the network. No READ_SMS / RECEIVE_SMS (spec §9.1.3).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For posting "clarification needed" notifications on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ExpenseTrackerApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">

        <!-- Sentry's ContentProvider auto-inits before Application.onCreate() and
             throws IllegalArgumentException ("DSN is required") when no DSN is in
             the manifest - crashing the app on every launch regardless of our
             BuildConfig.SENTRY_DSN.isBlank() guard in ExpenseTrackerApp, since that
             guard runs too late. Disabling auto-init here lets our manual init
             (which correctly no-ops when the DSN is blank) be the only init path. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExpenseTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ingestion.TransactionNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".clarification.ClarificationActionReceiver"
            android:exported="false" />

        <!-- Disable default WorkManager initializer; ExpenseTrackerApp provides custom config -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
